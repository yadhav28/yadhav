// pages/api/cars.js
export default function handler(req, res) {
  const cars = [
    { id: 1, brand: 'Toyota', model: 'Camry', price: 25000, fuelType: 'Petrol', seatingCapacity: 5, imageUrl: 'https://via.placeholder.com/150' },
    { id: 2, brand: 'Honda', model: 'Civic', price: 20000, fuelType: 'Diesel', seatingCapacity: 5, imageUrl: 'https://via.placeholder.com/150' },
    { id: 3, brand: 'BMW', model: 'X5', price: 60000, fuelType: 'Petrol', seatingCapacity: 7, imageUrl: 'https://via.placeholder.com/150' },
    { id: 4, brand: 'Tesla', model: 'Model 3', price: 35000, fuelType: 'Electric', seatingCapacity: 5, imageUrl: 'https://via.placeholder.com/150' },
    // More car data...
  ];

  const { brand, priceRange, fuelType, page = 1 } = req.query;
  let filteredCars = cars;

  if (brand) {
    filteredCars = filteredCars.filter(car => car.brand.toLowerCase().includes(brand.toLowerCase()));
  }
  if (fuelType) {
    filteredCars = filteredCars.filter(car => car.fuelType.toLowerCase() === fuelType.toLowerCase());
  }
  if (priceRange) {
    const [minPrice, maxPrice] = priceRange.split('-').map(Number);
    filteredCars = filteredCars.filter(car => car.price >= minPrice && car.price <= maxPrice);
  }

  const startIndex = (page - 1) * 10;
  const paginatedCars = filteredCars.slice(startIndex, startIndex + 10);

  res.status(200).json({ cars: paginatedCars, total: filteredCars.length });
}
// pages/index.js
import { useState, useEffect } from 'react';
import Link from 'next/link';

export default function Home() {
  const [cars, setCars] = useState([]);
  const [filters, setFilters] = useState({ brand: '', priceRange: '', fuelType: '' });
  const [page, setPage] = useState(1);
  const [totalCars, setTotalCars] = useState(0);

  useEffect(() => {
    const fetchCars = async () => {
      const query = new URLSearchParams({
        brand: filters.brand,
        priceRange: filters.priceRange,
        fuelType: filters.fuelType,
        page,
      }).toString();
      const response = await fetch(`/api/cars?${query}`);
      const data = await response.json();
      setCars(data.cars);
      setTotalCars(data.total);
    };

    fetchCars();
  }, [filters, page]);

  const addToWishlist = (car) => {
    const wishlist = JSON.parse(localStorage.getItem('wishlist')) || [];
    wishlist.push(car);
    localStorage.setItem('wishlist', JSON.stringify(wishlist));
  };

  return (
    <div className="container mx-auto p-4">
      <div className="flex mb-4">
        <input
          type="text"
          placeholder="Search by brand"
          value={filters.brand}
          onChange={(e) => setFilters({ ...filters, brand: e.target.value })}
          className="border p-2 rounded"
        />
        <select
          onChange={(e) => setFilters({ ...filters, fuelType: e.target.value })}
          value={filters.fuelType}
          className="border p-2 rounded ml-2"
        >
          <option value="">Fuel Type</option>
          <option value="Petrol">Petrol</option>
          <option value="Diesel">Diesel</option>
          <option value="Electric">Electric</option>
        </select>
        <select
          onChange={(e) => setFilters({ ...filters, priceRange: e.target.value })}
          value={filters.priceRange}
          className="border p-2 rounded ml-2"
        >
          <option value="">Price Range</option>
          <option value="0-20000">Under $20,000</option>
          <option value="20000-50000">$20,000 - $50,000</option>
          <option value="50000-100000">$50,000 - $100,000</option>
        </select>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {cars.map((car) => (
          <div key={car.id} className="border p-4 rounded">
            <img src={car.imageUrl} alt={car.model} className="w-full h-32 object-cover rounded mb-4" />
            <h2 className="text-xl">{car.brand} {car.model}</h2>
            <p className="text-gray-500">{car.fuelType} | ${car.price}</p>
            <p>Seats: {car.seatingCapacity}</p>
            <button className="bg-blue-500 text-white p-2 rounded mt-2" onClick={() => addToWishlist(car)}>
              Add to Wishlist
            </button>
          </div>
        ))}
      </div>

      <div className="mt-4 flex justify-between">
        <button onClick={() => setPage(page - 1)} disabled={page <= 1}>Previous</button>
        <button onClick={() => setPage(page + 1)} disabled={page * 10 >= totalCars}>Next</button>
      </div>
    </div>
  );
}
